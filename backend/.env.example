# DejaView backend configuration
# Copy this file to backend/.env. The copied file is ignored by Git.

# Zero-cost local mode (no API key required)
DEJAVIEW_PROVIDER=mock
DEJAVIEW_CRAWLER=stub
DEJAVIEW_REPOMAP=stub
DEJAVIEW_SEARCH_PROVIDER=mock

# Real analysis example (uncomment and provide the key in backend/.env only)
# DEJAVIEW_PROVIDER=deepseek
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# DEJAVIEW_MODEL_CHEAP=deepseek-v4-flash
# DEJAVIEW_MODEL_STANDARD=deepseek-v4-pro
# DEJAVIEW_MODEL_STRONG=deepseek-v4-pro
# DEJAVIEW_CRAWLER=builtin
# DEJAVIEW_REPOMAP=builtin
# DEJAVIEW_SEARCH_PROVIDER=github
# GITHUB_TOKEN=<optional-github-token>

# Public deployment protection. Leave blank to disable the access gate.
DEJAVIEW_ACCESS_CODE=

# HTTP boundary. Comma-separated origins and trusted proxy IP/CIDR values.
DEJAVIEW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only add an address when that proxy overwrites X-Forwarded-For.
DEJAVIEW_TRUSTED_PROXIES=

# Cost and runtime controls
DEJAVIEW_MAX_CANDIDATES_DEEP_READ=3
DEJAVIEW_MAX_QUERIES=8
DEJAVIEW_RATE_LIMIT_ENABLED=false
DEJAVIEW_RATE_LIMIT_PER_IP_HOURLY=10
DEJAVIEW_RATE_LIMIT_PER_IP_DAILY=0
DEJAVIEW_RATE_LIMIT_DAILY_TOTAL=200
# DEJAVIEW_CACHE_DIR=
# DEJAVIEW_LOG_LEVEL=INFO
