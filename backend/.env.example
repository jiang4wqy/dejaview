# ============ DejaView 后端配置 ============
# 复制成 backend/.env(已 gitignore)。默认(什么都不设)= 全 mock/stub, 零成本离线跑通。

# ---------- 真实模式(推荐) ----------
# 1) LLM —— 国内 DeepSeek(便宜, 需 key)
DEEPSEEK_API_KEY=sk-xxx
DEJAVIEW_PROVIDER=deepseek
DEJAVIEW_MODEL_CHEAP=deepseek-v4-flash      # 提取 / 结构化
DEJAVIEW_MODEL_STANDARD=deepseek-v4-pro     # 判断 / 验证
DEJAVIEW_MODEL_STRONG=deepseek-v4-pro       # 难例 / 裁判
#   或 Claude: DEJAVIEW_PROVIDER=claude + ANTHROPIC_API_KEY=sk-ant-xxx(分层 haiku/sonnet/opus)
#   或 Qwen:   DEJAVIEW_PROVIDER=qwen   + DASHSCOPE_API_KEY=xxx

# 2) 真实抓取 / 仓库 / 搜索(内置实现, 免 key)
DEJAVIEW_CRAWLER=builtin         # builtin | stub | firecrawl | crawl4ai
DEJAVIEW_REPOMAP=builtin         # builtin | stub | gitingest | aider
DEJAVIEW_SEARCH_PROVIDER=github  # github | mock | tavily
#   GitHub 搜索免 key 可用; 设 GITHUB_TOKEN 提额(30/分); 代理环境需 pip install "httpx[socks]"
# GITHUB_TOKEN=ghp_xxx

# 3) 成本 / 时长控制
DEJAVIEW_MAX_CANDIDATES_DEEP_READ=3   # verify 深读次数(=贵模型调用数)
DEJAVIEW_MAX_QUERIES=8
# DEJAVIEW_CACHE_DIR=                  # 留空=关闭磁盘缓存
# DEJAVIEW_LOG_LEVEL=INFO

# ---------- 离线 mock(零成本, 无需任何 key) ----------
# DEJAVIEW_PROVIDER=mock
# DEJAVIEW_CRAWLER=stub
# DEJAVIEW_REPOMAP=stub
# DEJAVIEW_SEARCH_PROVIDER=mock
