# ---- LLM provider: mock(默认, 零成本) | claude | deepseek | qwen ----
DEJAVIEW_PROVIDER=mock

# claude 时:
# ANTHROPIC_API_KEY=sk-ant-xxx
# deepseek / qwen 时(OpenAI 兼容):
# DEEPSEEK_API_KEY=xxx
# DASHSCOPE_API_KEY=xxx          # Qwen(DashScope)

# ---- 分层模型(可插拔默认值; 切国内模型时改成 deepseek-chat / qwen-plus 等) ----
DEJAVIEW_MODEL_CHEAP=claude-haiku-4-5       # 提取 / 结构化
DEJAVIEW_MODEL_STANDARD=claude-sonnet-5     # 判断 / 验证
DEJAVIEW_MODEL_STRONG=claude-opus-4-8       # 难例 / 裁判
DEJAVIEW_LLM_RETRIES=2

# ---- 执行端(均可插拔; 默认 stub/mock 让流水线零成本跑通) ----
DEJAVIEW_CRAWLER=stub             # stub | firecrawl | crawl4ai
DEJAVIEW_REPOMAP=stub             # stub | gitingest | aider
DEJAVIEW_SEARCH_PROVIDER=mock     # mock | tavily | github

# ---- OpenAI 兼容端点(可覆盖) ----
# DEJAVIEW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEJAVIEW_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 其它 ----
# DEJAVIEW_CACHE_DIR=             # 留空=关闭磁盘缓存
DEJAVIEW_MAX_CANDIDATES_DEEP_READ=5
DEJAVIEW_MAX_QUERIES=8
# DEJAVIEW_LOG_LEVEL=INFO
