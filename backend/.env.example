# ---- provider ----
# mock: 零成本、无需 key, 用 fixtures 跑通整条流水线 (默认)
# claude: 走真实 Claude, 需要 ANTHROPIC_API_KEY 或 `ant auth login`
DEJAVIEW_PROVIDER=mock

# 切到 claude 时:
# ANTHROPIC_API_KEY=sk-ant-xxx

# ---- Claude 分层模型 (可插拔的默认值; 便宜步骤走小模型) ----
DEJAVIEW_MODEL_CHEAP=claude-haiku-4-5      # 提取 / 结构化
DEJAVIEW_MODEL_STANDARD=claude-sonnet-5    # 判断 / 验证
DEJAVIEW_MODEL_STRONG=claude-opus-4-8      # 难例 / 裁判

# ---- 搜索执行端 ----
# mock | tavily | firecrawl | bing ...  (真实实现见 docs/TODO.md)
DEJAVIEW_SEARCH=mock

# ---- 其它 ----
# DEJAVIEW_CACHE_DIR=            # 留空=关闭磁盘缓存
DEJAVIEW_MAX_DEEP_READ=5         # 深读候选数上限
DEJAVIEW_MAX_QUERIES=8           # 检索 query 数上限
