# docker compose 部署配置。用法: cp deploy.env.example .env  然后填好, 再 docker compose up -d --build
# (docker compose 会自动读取项目根目录的 .env)

# LLM(二选一)
DEEPSEEK_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx   # 并把 DEJAVIEW_PROVIDER=claude

DEJAVIEW_PROVIDER=deepseek
DEJAVIEW_MODEL_CHEAP=deepseek-v4-flash
DEJAVIEW_MODEL_STANDARD=deepseek-v4-pro
DEJAVIEW_MODEL_STRONG=deepseek-v4-pro

# 搜索(composite=多源合并)
DEJAVIEW_SEARCH_PROVIDER=composite
DEJAVIEW_SEARCH_SOURCES=github,v2ex
# GITHUB_TOKEN=ghp_xxx           # 可选, 提高 GitHub 搜索速率

# 前端→后端地址：单端口部署无需设置(浏览器走同源 /api，前端自动反代到后端)。
# 仅当你把前后端拆开、让浏览器直连后端时才填，例如:
# NEXT_PUBLIC_API_BASE=https://api.你的域名.com
