# Docker Compose deployment configuration
# Copy to .env, replace placeholders, then run: docker compose up -d --build

DEJAVIEW_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# DASHSCOPE_API_KEY=<your-dashscope-api-key>

DEJAVIEW_MODEL_CHEAP=deepseek-v4-flash
DEJAVIEW_MODEL_STANDARD=deepseek-v4-pro
DEJAVIEW_MODEL_STRONG=deepseek-v4-pro

DEJAVIEW_CRAWLER=builtin
DEJAVIEW_REPOMAP=builtin
DEJAVIEW_SEARCH_PROVIDER=composite
DEJAVIEW_SEARCH_SOURCES=github,v2ex
# GITHUB_TOKEN=<optional-github-token>
# TAVILY_API_KEY=<optional-tavily-api-key>

# Recommended for any public deployment. Leave blank to disable the gate.
DEJAVIEW_ACCESS_CODE=<choose-a-strong-access-code>

# Browser origins allowed to call the API directly. The bundled frontend uses /api.
DEJAVIEW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep empty unless a known reverse proxy overwrites X-Forwarded-For.
DEJAVIEW_TRUSTED_PROXIES=

DEJAVIEW_RATE_LIMIT_ENABLED=true
DEJAVIEW_RATE_LIMIT_PER_IP_HOURLY=10
DEJAVIEW_RATE_LIMIT_PER_IP_DAILY=0
DEJAVIEW_RATE_LIMIT_DAILY_TOTAL=200

# Only set this when the browser should call a separate public API origin.
# NEXT_PUBLIC_API_BASE=https://api.example.com
